# Keep this file safe to commit. Never commit .env.
# Extraction provider: auto | ollama | groq
EXTRACTION_PROVIDER=auto

# Local Ollama
# Primary local extraction model.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=2000

# External-processing gate. Keep false until Humaniti explicitly approves it.
ALLOW_EXTERNAL_PROCESSING=false

# Groq fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
